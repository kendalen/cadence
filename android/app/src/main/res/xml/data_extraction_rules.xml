<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup is explicit and user-initiated, through the JSON export path
  (CLAUDE.md §5). android:allowBackup="false" switches off cloud backup, but on
  Android 12 (API 31) and above it does NOT stop device-to-device transfer —
  that needs the exclusions below. Both sections exclude everything.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
