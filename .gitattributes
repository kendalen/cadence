# Enforce LF line endings in the repository and on checkout, on every platform.
#
# This project is developed across more than one machine, one of which is a
# Windows-on-Arm (ARM64) box; work also happens from an Arm64 WSL/Linux
# environment. Without this file, Windows Git with core.autocrlf=true rewrites
# files to CRLF on checkout, which makes the pre-commit gate's
# `dart format --set-exit-if-changed` fail on every file. The `eol=lf` attributes
# override core.autocrlf, so working-tree files are LF regardless of the machine
# or the local Git configuration.

# Default: treat as text, normalise to LF.
* text=auto eol=lf

# Source and config we author — explicit LF.
*.dart       text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.json       text eol=lf
*.arb        text eol=lf
*.md         text eol=lf
*.gradle     text eol=lf
*.kts        text eol=lf
*.xml        text eol=lf
*.properties text eol=lf
*.sh         text eol=lf

# Windows batch files must stay CRLF if ever added to the repo.
*.bat        text eol=crlf

# Binary assets — never normalise.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.jks      binary
*.keystore binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.so       binary
*.jar      binary
